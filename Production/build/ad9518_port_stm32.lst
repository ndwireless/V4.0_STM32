 130:Core/Src/ad9518_port_stm32.c **** /*                                                                      */
 131:Core/Src/ad9518_port_stm32.c **** /* The ADC shares SCLK and SDIO with the clock chip and has its own      */
 132:Core/Src/ad9518_port_stm32.c **** /* chip select. Its serial pins are DRVDD (1.8 V) referenced, so the     */
 133:Core/Src/ad9518_port_stm32.c **** /* level translator between the STM32 and the ADC must be in circuit.    */
 134:Core/Src/ad9518_port_stm32.c **** /* ------------------------------------------------------------------ */
