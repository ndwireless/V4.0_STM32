  25:Core/Src/ad9518_port_stm32.c **** /*
  26:Core/Src/ad9518_port_stm32.c ****  * AD9518 hardware RESET, active low.
  27:Core/Src/ad9518_port_stm32.c ****  *
  28:Core/Src/ad9518_port_stm32.c ****  * CubeMX's MX_GPIO_Init drives this pin LOW at startup along with the chip
  29:Core/Src/ad9518_port_stm32.c ****  * selects, which holds the part in reset indefinitely. It must be released
  30:Core/Src/ad9518_port_stm32.c ****  * before any serial access or the AD9518 ignores the bus completely while
  31:Core/Src/ad9518_port_stm32.c ****  * CS, SCLK and SDIO all still look perfectly healthy on a scope.
  32:Core/Src/ad9518_port_stm32.c ****  */
  33:Core/Src/ad9518_port_stm32.c **** #define RST_PORT RST_CLK_GPIO_Port
ARM GAS  /var/folders/0g/t37nqzqx51l7sfxbqc44l9hw0000gn/T//cczw4UTv.s 			page 2


