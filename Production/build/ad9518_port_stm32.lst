 120:Core/Src/ad9518_port_stm32.c **** /*
 121:Core/Src/ad9518_port_stm32.c ****  * Toggle each serial-port line on its own, slowly, announcing which one is
 122:Core/Src/ad9518_port_stm32.c ****  * moving. Probe at the AD9518's own pins (not the MCU's) with a meter or
 123:Core/Src/ad9518_port_stm32.c ****  * scope: the line that is announced should be the line that moves. This is
 124:Core/Src/ad9518_port_stm32.c ****  * how you confirm the nets actually reach the part.
 125:Core/Src/ad9518_port_stm32.c ****  *
 126:Core/Src/ad9518_port_stm32.c ****  * Runs forever; reset the board to stop.
ARM GAS  /var/folders/0g/t37nqzqx51l7sfxbqc44l9hw0000gn/T//cczw4UTv.s 			page 6


 127:Core/Src/ad9518_port_stm32.c ****  */
