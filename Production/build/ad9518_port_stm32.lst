  36:Core/Src/ad9518_port_stm32.c **** /*
  37:Core/Src/ad9518_port_stm32.c ****  * Dedicated SDO pin (4-wire mode). This board is 3-wire: the AD9518's SDO
  38:Core/Src/ad9518_port_stm32.c ****  * is not connected, so 4-wire must stay disabled. Testing it against a
  39:Core/Src/ad9518_port_stm32.c ****  * floating input would only produce misleading results.
  40:Core/Src/ad9518_port_stm32.c ****  */
  41:Core/Src/ad9518_port_stm32.c **** /* #define AD9518_HAS_SDO */
