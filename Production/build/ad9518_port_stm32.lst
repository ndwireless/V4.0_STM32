  76:Core/Src/ad9518_port_stm32.c **** 
  77:Core/Src/ad9518_port_stm32.c **** static void port_sdio_dir(int output)
  78:Core/Src/ad9518_port_stm32.c **** {
  79:Core/Src/ad9518_port_stm32.c ****     GPIO_InitTypeDef g = {0};
  80:Core/Src/ad9518_port_stm32.c ****     g.Pin = SDIO_PIN;
  81:Core/Src/ad9518_port_stm32.c ****     g.Speed = GPIO_SPEED_FREQ_HIGH;
  82:Core/Src/ad9518_port_stm32.c **** 
  83:Core/Src/ad9518_port_stm32.c ****     if (output)
  84:Core/Src/ad9518_port_stm32.c ****     {
  85:Core/Src/ad9518_port_stm32.c ****         g.Mode = GPIO_MODE_OUTPUT_PP;
  86:Core/Src/ad9518_port_stm32.c ****         g.Pull = GPIO_NOPULL;
  87:Core/Src/ad9518_port_stm32.c ****     }
  88:Core/Src/ad9518_port_stm32.c ****     else
  89:Core/Src/ad9518_port_stm32.c ****     {
  90:Core/Src/ad9518_port_stm32.c ****         g.Mode = GPIO_MODE_INPUT;
  91:Core/Src/ad9518_port_stm32.c ****         /* No pull. A pull-up here masks a non-responding part by making a
  92:Core/Src/ad9518_port_stm32.c ****          * floating line read back as 0xFF, which looks like valid data. */
  93:Core/Src/ad9518_port_stm32.c ****         g.Pull = GPIO_NOPULL;
  94:Core/Src/ad9518_port_stm32.c ****     }
  95:Core/Src/ad9518_port_stm32.c ****     HAL_GPIO_Init(SDIO_PORT, &g);
  96:Core/Src/ad9518_port_stm32.c **** }
