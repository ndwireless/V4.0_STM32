  27:Core/Src/ad9613.c **** /* ------------------------------------------------------------------ */
  28:Core/Src/ad9613.c **** /* bit-banged serial port                                              */
  29:Core/Src/ad9613.c **** /*                                                                     */
  30:Core/Src/ad9613.c **** /* AN-877 format: a 16-bit instruction word, then data. Bit 15 is R/W,  */
  31:Core/Src/ad9613.c **** /* bits 14:13 (W1:W0) give the byte count minus one, bits 12:0 are the  */
  32:Core/Src/ad9613.c **** /* address. Single-byte transfers only here, so W1:W0 = 00.             */
  33:Core/Src/ad9613.c **** /*                                                                     */
  34:Core/Src/ad9613.c **** /* SCLK idles low. Write data is registered on the SCLK rising edge and */
  35:Core/Src/ad9613.c **** /* read data on the falling edge, so read data is sampled while SCLK is */
  36:Core/Src/ad9613.c **** /* low - before the clock pulse, which also keeps the final bit inside  */
  37:Core/Src/ad9613.c **** /* the window where the part is still driving SDIO.                     */
  38:Core/Src/ad9613.c **** /* ------------------------------------------------------------------ */
  39:Core/Src/ad9613.c **** 
