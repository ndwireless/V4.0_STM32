  25:Core/Src/ad9518_stm.c **** /* ---- WRITE: TX only ----------------------------------------------------- */
  26:Core/Src/ad9518_stm.c **** static int stm32_spi_write(const uint8_t *buf, uint16_t len)
  27:Core/Src/ad9518_stm.c **** {
  28:Core/Src/ad9518_stm.c ****     HAL_StatusTypeDef s;
  29:Core/Src/ad9518_stm.c ****     cs_low();
  30:Core/Src/ad9518_stm.c ****     spi_dir_tx();
  31:Core/Src/ad9518_stm.c ****     s = HAL_SPI_Transmit(&hspi1, (uint8_t *)buf, len, HAL_MAX_DELAY);
  32:Core/Src/ad9518_stm.c ****     cs_high();
  33:Core/Src/ad9518_stm.c ****     return (s == HAL_OK) ? 0 : -1;
  34:Core/Src/ad9518_stm.c **** }
  35:Core/Src/ad9518_stm.c **** 
  36:Core/Src/ad9518_stm.c **** /* ---- READ: TX instruction, turn line around, RX data -------------------- */
  37:Core/Src/ad9518_stm.c **** static int stm32_spi_read(const uint8_t *tx, uint16_t txlen,
  38:Core/Src/ad9518_stm.c ****                           uint8_t *rx, uint16_t rxlen)
  39:Core/Src/ad9518_stm.c **** {
  40:Core/Src/ad9518_stm.c ****     HAL_StatusTypeDef s;
  41:Core/Src/ad9518_stm.c ****     cs_low();
  42:Core/Src/ad9518_stm.c **** 
  43:Core/Src/ad9518_stm.c ****     /* Phase 1: send instruction, host drives SDIO */
  44:Core/Src/ad9518_stm.c ****     spi_dir_tx();
  45:Core/Src/ad9518_stm.c ****     s = HAL_SPI_Transmit(&hspi1, (uint8_t *)tx, txlen, HAL_MAX_DELAY);
  46:Core/Src/ad9518_stm.c ****     if (s != HAL_OK)
  47:Core/Src/ad9518_stm.c ****     {
  48:Core/Src/ad9518_stm.c ****         cs_high();
  49:Core/Src/ad9518_stm.c ****         return -1;
  50:Core/Src/ad9518_stm.c ****     }
  51:Core/Src/ad9518_stm.c **** 
  52:Core/Src/ad9518_stm.c ****     /* Phase 2: turn line around; the chip drives SDIO with readback.
  53:Core/Src/ad9518_stm.c ****      * In half-duplex master RX the clock runs continuously once enabled,
  54:Core/Src/ad9518_stm.c ****      * so HAL_SPI_Receive handles the fixed count, but we make sure SPI is
  55:Core/Src/ad9518_stm.c ****      * left disabled afterward to stop clocking. */
  56:Core/Src/ad9518_stm.c ****     spi_dir_rx();
  57:Core/Src/ad9518_stm.c ****     s = HAL_SPI_Receive(&hspi1, rx, rxlen, HAL_MAX_DELAY);
  58:Core/Src/ad9518_stm.c ****     __HAL_SPI_DISABLE(&hspi1); /* stop the continuous clock immediately */
  59:Core/Src/ad9518_stm.c **** 
  60:Core/Src/ad9518_stm.c ****     cs_high();
  61:Core/Src/ad9518_stm.c **** 
  62:Core/Src/ad9518_stm.c ****     /* Restore to TX (idle) direction for the next write */
  63:Core/Src/ad9518_stm.c ****     spi_dir_tx();
  64:Core/Src/ad9518_stm.c **** 
  65:Core/Src/ad9518_stm.c ****     return (s == HAL_OK) ? 0 : -1;
  66:Core/Src/ad9518_stm.c **** }
