  57:Core/Src/ad9518_stm.c **** /* WRITE: hardware SPI half-duplex TX (reliable direction). */
  58:Core/Src/ad9518_stm.c **** static int stm32_spi_write(const uint8_t *buf, uint16_t len)
  59:Core/Src/ad9518_stm.c **** {
  60:Core/Src/ad9518_stm.c ****     pin_af(SCK_PORT, SCK_PIN);
  61:Core/Src/ad9518_stm.c ****     pin_af(SDIO_PORT, SDIO_PIN);
  62:Core/Src/ad9518_stm.c ****     hspi1.Instance->CR1 &= ~SPI_CR1_SPE_BIT;
  63:Core/Src/ad9518_stm.c ****     hspi1.Instance->CR1 |= SPI_CR1_BIDIOE_BIT; /* drive output */
  64:Core/Src/ad9518_stm.c ****     hspi1.Instance->CR1 |= SPI_CR1_SPE_BIT;
  65:Core/Src/ad9518_stm.c **** 
  66:Core/Src/ad9518_stm.c ****     cs_low();
  67:Core/Src/ad9518_stm.c ****     HAL_StatusTypeDef s = HAL_SPI_Transmit(&hspi1, (uint8_t *)buf, len, HAL_MAX_DELAY);
  68:Core/Src/ad9518_stm.c ****     while (__HAL_SPI_GET_FLAG(&hspi1, SPI_FLAG_BSY))
  69:Core/Src/ad9518_stm.c ****     {
  70:Core/Src/ad9518_stm.c ****     }
  71:Core/Src/ad9518_stm.c ****     cs_high();
  72:Core/Src/ad9518_stm.c **** 
  73:Core/Src/ad9518_stm.c ****     hspi1.Instance->CR1 &= ~SPI_CR1_SPE_BIT;
  74:Core/Src/ad9518_stm.c ****     return (s == HAL_OK) ? 0 : -1;
  75:Core/Src/ad9518_stm.c **** }
  76:Core/Src/ad9518_stm.c **** 
  77:Core/Src/ad9518_stm.c **** /* READ: bit-banged, explicit turnaround dead-time to survive half-duplex. */
  78:Core/Src/ad9518_stm.c **** static int stm32_spi_read(const uint8_t *tx, uint16_t txlen,
  79:Core/Src/ad9518_stm.c ****                           uint8_t *rx, uint16_t rxlen)
  80:Core/Src/ad9518_stm.c **** {
  81:Core/Src/ad9518_stm.c ****     hspi1.Instance->CR1 &= ~SPI_CR1_SPE_BIT;
  82:Core/Src/ad9518_stm.c ****     pin_out(SCK_PORT, SCK_PIN);
  83:Core/Src/ad9518_stm.c ****     pin_out(SDIO_PORT, SDIO_PIN);
  84:Core/Src/ad9518_stm.c ****     HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_RESET);
  85:Core/Src/ad9518_stm.c **** 
  86:Core/Src/ad9518_stm.c ****     cs_low();
  87:Core/Src/ad9518_stm.c ****     bb();
  88:Core/Src/ad9518_stm.c **** 
  89:Core/Src/ad9518_stm.c ****     for (uint16_t byi = 0; byi < txlen; byi++)
  90:Core/Src/ad9518_stm.c ****     {
  91:Core/Src/ad9518_stm.c ****         for (int bit = 7; bit >= 0; bit--)
  92:Core/Src/ad9518_stm.c ****         {
  93:Core/Src/ad9518_stm.c ****             HAL_GPIO_WritePin(SDIO_PORT, SDIO_PIN,
  94:Core/Src/ad9518_stm.c ****                               (tx[byi] & (1 << bit)) ? GPIO_PIN_SET : GPIO_PIN_RESET);
  95:Core/Src/ad9518_stm.c ****             bb();
ARM GAS  /var/folders/0g/t37nqzqx51l7sfxbqc44l9hw0000gn/T//ccLHx8Cm.s 			page 4


  96:Core/Src/ad9518_stm.c ****             HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_SET);
  97:Core/Src/ad9518_stm.c ****             bb();
  98:Core/Src/ad9518_stm.c ****             HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_RESET);
  99:Core/Src/ad9518_stm.c ****         }
 100:Core/Src/ad9518_stm.c ****     }
 101:Core/Src/ad9518_stm.c **** 
 102:Core/Src/ad9518_stm.c ****     pin_in(SDIO_PORT, SDIO_PIN); /* turnaround */
 103:Core/Src/ad9518_stm.c ****     bb();
 104:Core/Src/ad9518_stm.c ****     bb();
 105:Core/Src/ad9518_stm.c ****     bb();
 106:Core/Src/ad9518_stm.c **** 
 107:Core/Src/ad9518_stm.c ****     for (uint16_t byi = 0; byi < rxlen; byi++)
 108:Core/Src/ad9518_stm.c ****     {
 109:Core/Src/ad9518_stm.c ****         uint8_t v = 0;
 110:Core/Src/ad9518_stm.c ****         for (int bit = 7; bit >= 0; bit--)
 111:Core/Src/ad9518_stm.c ****         {
 112:Core/Src/ad9518_stm.c ****             HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_SET);
 113:Core/Src/ad9518_stm.c ****             bb();
 114:Core/Src/ad9518_stm.c ****             HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_RESET);
 115:Core/Src/ad9518_stm.c ****             bb();
 116:Core/Src/ad9518_stm.c ****             if (HAL_GPIO_ReadPin(SDIO_PORT, SDIO_PIN) == GPIO_PIN_SET)
 117:Core/Src/ad9518_stm.c ****                 v |= (1 << bit);
 118:Core/Src/ad9518_stm.c ****         }
 119:Core/Src/ad9518_stm.c ****         rx[byi] = v;
 120:Core/Src/ad9518_stm.c ****     }
 121:Core/Src/ad9518_stm.c **** 
 122:Core/Src/ad9518_stm.c ****     cs_high();
 123:Core/Src/ad9518_stm.c ****     pin_af(SCK_PORT, SCK_PIN);
 124:Core/Src/ad9518_stm.c ****     pin_af(SDIO_PORT, SDIO_PIN);
 125:Core/Src/ad9518_stm.c ****     return 0;
 126:Core/Src/ad9518_stm.c **** }
