  12:Core/Src/app_main.c **** /* ---- Board parameters. Change these to match your hardware. ---- */
  13:Core/Src/app_main.c **** #define REF_HZ 25000000UL     /* REF1 input frequency */
  14:Core/Src/app_main.c **** #define TARGET_HZ 175000000UL /* desired output on OUT0..OUT3 */
  15:Core/Src/app_main.c **** 
  16:Core/Src/app_main.c **** /*
  17:Core/Src/app_main.c ****  * VCO tuning range. This board carries an AD9518-3, whose on-chip VCO tunes
  18:Core/Src/app_main.c ****  * from 1.75 GHz to 2.25 GHz. The planner only searches inside this window.
  19:Core/Src/app_main.c ****  *
  20:Core/Src/app_main.c ****  * With a 25 MHz reference the chosen plan is N=84 -> VCO 2100 MHz, VCO
  21:Core/Src/app_main.c ****  * divider /2 -> 1050 MHz, channel divider /6 -> 175.000 MHz exactly. 2100
  22:Core/Src/app_main.c ****  * MHz is comfortably inside the -3's range.
  23:Core/Src/app_main.c ****  *
  24:Core/Src/app_main.c ****  * Other grades, if the board is ever repopulated:
  25:Core/Src/app_main.c ****  *   AD9518-0  2.55 - 2.95 GHz
  26:Core/Src/app_main.c ****  *   AD9518-1  2.30 - 2.65 GHz (approx; confirm)
  27:Core/Src/app_main.c ****  *   AD9518-3  1.75 - 2.25 GHz
  28:Core/Src/app_main.c ****  */
  29:Core/Src/app_main.c **** #define VCO_MIN_HZ 1750000000UL
  30:Core/Src/app_main.c **** #define VCO_MAX_HZ 2250000000UL
  31:Core/Src/app_main.c **** 
  32:Core/Src/app_main.c **** /*
ARM GAS  /var/folders/0g/t37nqzqx51l7sfxbqc44l9hw0000gn/T//cckxEjxB.s 			page 2


  33:Core/Src/app_main.c ****  * Set to 1 to configure the part without requiring readback to work.
  34:Core/Src/app_main.c ****  *
  35:Core/Src/app_main.c ****  * Readback is only a diagnostic. If writes reach the AD9518 it will lock and
  36:Core/Src/app_main.c ****  * produce output whether or not the readback path works. On a board where
  37:Core/Src/app_main.c ****  * SDO is not connected and the part powers up with SDO_ACTIVE set, readback
  38:Core/Src/app_main.c ****  * lands on an unconnected pin and SDIO stays idle high - which looks exactly
  39:Core/Src/app_main.c ****  * like a dead part even though writes are fine. This mode programs the chip
  40:Core/Src/app_main.c ****  * anyway so you can confirm on a scope.
  41:Core/Src/app_main.c ****  *
  42:Core/Src/app_main.c ****  * Check OUT0/OUT1 for the target frequency, and the LD/STATUS pin for lock.
  43:Core/Src/app_main.c ****  */
  44:Core/Src/app_main.c **** #define BLIND_CONFIGURE 1
  45:Core/Src/app_main.c **** 
  46:Core/Src/app_main.c **** static ad9518_dev_t ad9518;
  47:Core/Src/app_main.c **** static ad9613_dev_t ad9613;
