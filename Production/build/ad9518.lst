 534:Core/Src/ad9518.c ****     /* --- PLL counters ---
 535:Core/Src/ad9518.c ****      *
 536:Core/Src/ad9518.c ****      * 0x010 is the PFD/charge-pump register. Bits[1:0] are the PLL power
 537:Core/Src/ad9518.c ****      * control: 00 = normal operation, 01 = asynchronous power-down.
 538:Core/Src/ad9518.c ****      *
 539:Core/Src/ad9518.c ****      * Use 0x7C, not 0x7D. The 0x7D value that appears in the ADI Linux
 540:Core/Src/ad9518.c ****      * driver's default register table has bits[1:0] = 01, which leaves the
 541:Core/Src/ad9518.c ****      * PLL powered down - that table is a starting point the driver then
 542:Core/Src/ad9518.c ****      * overwrites from a .stp firmware file, not a runnable configuration.
 543:Core/Src/ad9518.c ****      * With the PLL down, VCO calibration still completes and every register
 544:Core/Src/ad9518.c ****      * reads back correctly, but lock detect never asserts.
 545:Core/Src/ad9518.c ****      */
 546:Core/Src/ad9518.c ****     ad9518_write(d, AD9518_PFD_CP, 0x7C); /* PLL on, CP normal, PFD pol + */
