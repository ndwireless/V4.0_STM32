  28:Core/Src/ad9518.c **** /* ------------------------------------------------------------------ */
  29:Core/Src/ad9518.c **** /* bit-banged serial port                                              */
  30:Core/Src/ad9518.c **** /*                                                                     */
  31:Core/Src/ad9518.c **** /* Everything is bit-banged in both directions on purpose. Switching a */
  32:Core/Src/ad9518.c **** /* hardware SPI peripheral between transmit and receive mid-transaction */
  33:Core/Src/ad9518.c **** /* in half-duplex mode is the single most common source of AD951x       */
  34:Core/Src/ad9518.c **** /* readback failures, so the peripheral is not used at all.             */
  35:Core/Src/ad9518.c **** /*                                                                     */
  36:Core/Src/ad9518.c **** /* Format: SCLK idles low. The part latches write data on the SCLK      */
  37:Core/Src/ad9518.c **** /* rising edge and drives read data on the falling edge, so read data   */
  38:Core/Src/ad9518.c **** /* is stable while SCLK is high.                                        */
  39:Core/Src/ad9518.c **** /* ------------------------------------------------------------------ */
