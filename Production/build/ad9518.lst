 164:Core/Src/ad9518.c **** 
 165:Core/Src/ad9518.c **** int ad9518_transfer(ad9518_dev_t *d)
 166:Core/Src/ad9518.c **** {
 167:Core/Src/ad9518.c ****     return ad9518_write(d, AD9518_TRANSFER, AD9518_TRANSFER_NOW);
 168:Core/Src/ad9518.c **** }
 169:Core/Src/ad9518.c **** 
 170:Core/Src/ad9518.c **** /* ------------------------------------------------------------------ */
 171:Core/Src/ad9518.c **** /* identification and bus validation                                   */
 172:Core/Src/ad9518.c **** /* ------------------------------------------------------------------ */
 173:Core/Src/ad9518.c **** 
 174:Core/Src/ad9518.c **** int ad9518_part_id_valid(uint8_t id)
 175:Core/Src/ad9518.c **** {
 176:Core/Src/ad9518.c ****     switch (id)
 177:Core/Src/ad9518.c ****     {
 178:Core/Src/ad9518.c ****     /* AD9518 grades */
 179:Core/Src/ad9518.c ****     case 0x21:
 180:Core/Src/ad9518.c ****     case 0x61:
 181:Core/Src/ad9518.c ****     case 0xA1:
 182:Core/Src/ad9518.c ****     case 0x63:
 183:Core/Src/ad9518.c ****     case 0xE3:
 184:Core/Src/ad9518.c ****     /* AD9516 grades, in case the board is populated with a sibling part */
 185:Core/Src/ad9518.c ****     case 0x01:
 186:Core/Src/ad9518.c ****     case 0x41:
 187:Core/Src/ad9518.c ****     case 0x81:
 188:Core/Src/ad9518.c ****     case 0x43:
 189:Core/Src/ad9518.c ****     case 0xC3:
 190:Core/Src/ad9518.c ****     /* AD9517 grades */
 191:Core/Src/ad9518.c ****     case 0x11:
 192:Core/Src/ad9518.c ****     case 0x51:
 193:Core/Src/ad9518.c ****     case 0x91:
 194:Core/Src/ad9518.c ****     case 0x53:
 195:Core/Src/ad9518.c ****     case 0xD3:
 196:Core/Src/ad9518.c ****         return 1;
 197:Core/Src/ad9518.c ****     default:
 198:Core/Src/ad9518.c ****         return 0;
 199:Core/Src/ad9518.c ****     }
 200:Core/Src/ad9518.c **** }
 201:Core/Src/ad9518.c **** 
 202:Core/Src/ad9518.c **** int ad9518_soft_reset(ad9518_dev_t *d)
 203:Core/Src/ad9518.c **** {
 204:Core/Src/ad9518.c ****     /* In 3-wire the dedicated SDO pin must stay disabled so that readback
 205:Core/Src/ad9518.c ****      * comes back on SDIO. In 4-wire, SDO_ACTIVE enables the output pin.
 206:Core/Src/ad9518.c ****      * This mirrors the Linux driver's handling of SPI_3WIRE. */
 207:Core/Src/ad9518.c ****     uint8_t conf = AD9518_LONG_INSTR;
 208:Core/Src/ad9518.c ****     if (d->wire == AD9518_WIRE_4)
 209:Core/Src/ad9518.c ****         conf |= AD9518_SDO_ACTIVE;
 210:Core/Src/ad9518.c **** 
 211:Core/Src/ad9518.c ****     ad9518_write(d, AD9518_SERCONF, (uint8_t)(conf | AD9518_SOFT_RESET));
 212:Core/Src/ad9518.c ****     d->delay_ms(2);
 213:Core/Src/ad9518.c ****     ad9518_write(d, AD9518_SERCONF, conf);
 214:Core/Src/ad9518.c ****     d->delay_ms(2);
 215:Core/Src/ad9518.c **** 
ARM GAS  /var/folders/0g/t37nqzqx51l7sfxbqc44l9hw0000gn/T//ccBBrdod.s 			page 15


 216:Core/Src/ad9518.c ****     /* Read back the active registers rather than the write buffer, so a
 217:Core/Src/ad9518.c ****      * verify after TRANSFER reflects what the part is really using. */
 218:Core/Src/ad9518.c ****     ad9518_write(d, AD9518_RB_CTL, AD9518_RB_READ_ACTIVE);
 219:Core/Src/ad9518.c ****     return 0;
 220:Core/Src/ad9518.c **** }
 221:Core/Src/ad9518.c **** 
 222:Core/Src/ad9518.c **** int ad9518_part_id(ad9518_dev_t *d, uint8_t *id)
 223:Core/Src/ad9518.c **** {
 224:Core/Src/ad9518.c ****     return ad9518_read(d, AD9518_PARTID, id);
 225:Core/Src/ad9518.c **** }
 226:Core/Src/ad9518.c **** 
 227:Core/Src/ad9518.c **** int ad9518_bus_autoprobe(ad9518_dev_t *d)
 228:Core/Src/ad9518.c **** {
 229:Core/Src/ad9518.c ****     static const char *wire_name[2] = {"3-wire", "4-wire"};
 230:Core/Src/ad9518.c ****     static const char *sample_name[2] = {"SCLK high", "SCLK low "};
 231:Core/Src/ad9518.c ****     static const char *instr_name[2] = {"long instr ", "short instr"};
 232:Core/Src/ad9518.c **** 
 233:Core/Src/ad9518.c ****     D(d, "[autoprobe] sweeping bus configurations\r\n");
 234:Core/Src/ad9518.c **** 
 235:Core/Src/ad9518.c ****     for (int in = 0; in < 2; in++)
 236:Core/Src/ad9518.c ****     {
 237:Core/Src/ad9518.c ****         for (int w = 0; w < 2; w++)
 238:Core/Src/ad9518.c ****         {
 239:Core/Src/ad9518.c ****             if (w == AD9518_WIRE_4 && d->sdo_read == 0)
 240:Core/Src/ad9518.c ****                 continue;
 241:Core/Src/ad9518.c **** 
 242:Core/Src/ad9518.c ****             for (int s = 0; s < 2; s++)
 243:Core/Src/ad9518.c ****             {
 244:Core/Src/ad9518.c ****                 d->instr = (ad9518_instr_t)in;
 245:Core/Src/ad9518.c ****                 d->wire = (ad9518_wire_t)w;
 246:Core/Src/ad9518.c ****                 d->sample = (ad9518_sample_t)s;
 247:Core/Src/ad9518.c **** 
 248:Core/Src/ad9518.c ****                 ad9518_soft_reset(d);
 249:Core/Src/ad9518.c **** 
 250:Core/Src/ad9518.c ****                 uint8_t id = 0;
 251:Core/Src/ad9518.c ****                 ad9518_part_id(d, &id);
 252:Core/Src/ad9518.c **** 
 253:Core/Src/ad9518.c ****                 Df(d, "  %s / %s / sample %s -> PARTID 0x%02X %s\r\n",
 254:Core/Src/ad9518.c ****                    instr_name[in], wire_name[w], sample_name[s], id,
 255:Core/Src/ad9518.c ****                    ad9518_part_id_valid(id) ? "<== VALID" : "");
 256:Core/Src/ad9518.c **** 
 257:Core/Src/ad9518.c ****                 if (ad9518_part_id_valid(id))
 258:Core/Src/ad9518.c ****                 {
 259:Core/Src/ad9518.c ****                     Df(d, "[autoprobe] using %s, %s, sample %s\r\n",
 260:Core/Src/ad9518.c ****                        instr_name[in], wire_name[w], sample_name[s]);
 261:Core/Src/ad9518.c ****                     return 0;
 262:Core/Src/ad9518.c ****                 }
 263:Core/Src/ad9518.c ****             }
 264:Core/Src/ad9518.c ****         }
 265:Core/Src/ad9518.c ****     }
 266:Core/Src/ad9518.c **** 
 267:Core/Src/ad9518.c ****     D(d, "[autoprobe] no working configuration found\r\n");
 268:Core/Src/ad9518.c ****     return -1;
 269:Core/Src/ad9518.c **** }
 270:Core/Src/ad9518.c **** 
 271:Core/Src/ad9518.c **** /*
 272:Core/Src/ad9518.c ****  * Decide whether anything is actually driving SDIO during the read phase.
ARM GAS  /var/folders/0g/t37nqzqx51l7sfxbqc44l9hw0000gn/T//ccBBrdod.s 			page 16


 273:Core/Src/ad9518.c ****  *
 274:Core/Src/ad9518.c ****  * The same register is read twice, once with the master parking SDIO low
 275:Core/Src/ad9518.c ****  * just before releasing it and once parking it high. If the byte read back
 276:Core/Src/ad9518.c ****  * follows the parked level, the line is floating and holding residual
 277:Core/Src/ad9518.c ****  * charge: the part is not responding. If both reads agree with each other
 278:Core/Src/ad9518.c ****  * and ignore the parked level, something really is driving the line, and
 279:Core/Src/ad9518.c ****  * the problem is sampling or protocol rather than a silent part.
 280:Core/Src/ad9518.c ****  */
 281:Core/Src/ad9518.c **** void ad9518_bus_diagnose(ad9518_dev_t *d)
 282:Core/Src/ad9518.c **** {
 283:Core/Src/ad9518.c ****     uint8_t lo = 0, hi = 0;
 284:Core/Src/ad9518.c **** 
 285:Core/Src/ad9518.c ****     D(d, "[diagnose] SDIO drive test\r\n");
 286:Core/Src/ad9518.c **** 
 287:Core/Src/ad9518.c ****     /* First: can the master itself control the line? This catches a short
 288:Core/Src/ad9518.c ****      * to a supply rail or ground, which would make everything else moot. */
 289:Core/Src/ad9518.c ****     d->sdio_dir(1);
 290:Core/Src/ad9518.c ****     d->sdio(1);
 291:Core/Src/ad9518.c ****     d->bit_delay();
 292:Core/Src/ad9518.c ****     int reads_high = d->sdio_read();
 293:Core/Src/ad9518.c ****     d->sdio(0);
 294:Core/Src/ad9518.c ****     d->bit_delay();
 295:Core/Src/ad9518.c ****     int reads_low = d->sdio_read();
 296:Core/Src/ad9518.c ****     d->sdio_dir(1);
 297:Core/Src/ad9518.c **** 
 298:Core/Src/ad9518.c ****     if (!reads_high || reads_low)
 299:Core/Src/ad9518.c ****     {
 300:Core/Src/ad9518.c ****         Df(d, "  MCU drives high -> reads %d, drives low -> reads %d\r\n",
 301:Core/Src/ad9518.c ****            reads_high, reads_low);
 302:Core/Src/ad9518.c ****         D(d, "  SDIO does not follow the master. The net is shorted or\r\n");
 303:Core/Src/ad9518.c ****         D(d, "  loaded by something else. Fix this before anything else.\r\n");
 304:Core/Src/ad9518.c ****         return;
 305:Core/Src/ad9518.c ****     }
 306:Core/Src/ad9518.c ****     D(d, "  SDIO follows the master when driven: net is not shorted\r\n");
 307:Core/Src/ad9518.c **** 
 308:Core/Src/ad9518.c ****     read_parked(d, AD9518_PARTID, &lo, 0);
 309:Core/Src/ad9518.c ****     read_parked(d, AD9518_PARTID, &hi, 1);
 310:Core/Src/ad9518.c **** 
 311:Core/Src/ad9518.c ****     Df(d, "  read with SDIO parked low  -> 0x%02X\r\n", lo);
 312:Core/Src/ad9518.c ****     Df(d, "  read with SDIO parked high -> 0x%02X\r\n", hi);
 313:Core/Src/ad9518.c **** 
 314:Core/Src/ad9518.c ****     if (lo == 0x00 && hi == 0xFF)
 315:Core/Src/ad9518.c ****     {
 316:Core/Src/ad9518.c ****         D(d, "  Result tracks the parked level exactly.\r\n");
 317:Core/Src/ad9518.c ****         D(d, "  The line is FLOATING during the read phase - the AD9518 is\r\n");
 318:Core/Src/ad9518.c ****         D(d, "  not driving it. This is not a sampling or timing problem.\r\n");
 319:Core/Src/ad9518.c ****         D(d, "  Likely causes, in order:\r\n");
 320:Core/Src/ad9518.c ****         D(d, "    1. A RESET or power-down pin on the part is asserted.\r\n");
 321:Core/Src/ad9518.c ****         D(d, "    2. CS is not reaching the part's CS pin (check the net,\r\n");
 322:Core/Src/ad9518.c ****         D(d, "       not just the MCU pin).\r\n");
 323:Core/Src/ad9518.c ****         D(d, "    3. Supplies missing or out of tolerance at the part.\r\n");
 324:Core/Src/ad9518.c ****         D(d, "    4. SDIO open circuit between the part and the MCU.\r\n");
 325:Core/Src/ad9518.c ****     }
 326:Core/Src/ad9518.c ****     else if (lo == hi && lo == 0xFF)
 327:Core/Src/ad9518.c ****     {
 328:Core/Src/ad9518.c ****         D(d, "  Both reads return 0xFF regardless of the parked level.\r\n");
 329:Core/Src/ad9518.c ****         D(d, "  The net is being pulled high - either by a pull-up resistor\r\n");
ARM GAS  /var/folders/0g/t37nqzqx51l7sfxbqc44l9hw0000gn/T//ccBBrdod.s 			page 17


 330:Core/Src/ad9518.c ****         D(d, "  on the board or by an active driver. These look identical\r\n");
 331:Core/Src/ad9518.c ****         D(d, "  from here, but note that if the AD9518 were driving, PARTID\r\n");
 332:Core/Src/ad9518.c ****         D(d, "  would be a real value rather than all ones. So the most\r\n");
 333:Core/Src/ad9518.c ****         D(d, "  likely reading is: a pull-up holds the line and the part is\r\n");
 334:Core/Src/ad9518.c ****         D(d, "  still silent. Check for a RESET or power-down pin that is\r\n");
 335:Core/Src/ad9518.c ****         D(d, "  asserted, and CS continuity at the part's own pin.\r\n");
 336:Core/Src/ad9518.c ****     }
 337:Core/Src/ad9518.c ****     else if (lo == hi)
 338:Core/Src/ad9518.c ****     {
 339:Core/Src/ad9518.c ****         Df(d, "  Both reads agree (0x%02X) and ignore the parked level.\r\n", lo);
 340:Core/Src/ad9518.c ****         D(d, "  Something is actively driving the line with real data, so\r\n");
 341:Core/Src/ad9518.c ****         D(d, "  the part is responding. Suspect sample phase, bit order or\r\n");
 342:Core/Src/ad9518.c ****         D(d, "  instruction framing rather than wiring.\r\n");
 343:Core/Src/ad9518.c ****     }
 344:Core/Src/ad9518.c ****     else
 345:Core/Src/ad9518.c ****     {
 346:Core/Src/ad9518.c ****         D(d, "  Mixed result: partially driven, partially floating.\r\n");
 347:Core/Src/ad9518.c ****         D(d, "  Suspect marginal drive strength, a series resistor that is\r\n");
 348:Core/Src/ad9518.c ****         D(d, "  too large, or excessive capacitance. Try a slower bus with\r\n");
 349:Core/Src/ad9518.c ****         D(d, "  ad9518_port_set_bit_delay().\r\n");
 350:Core/Src/ad9518.c ****     }
 351:Core/Src/ad9518.c **** }
 352:Core/Src/ad9518.c **** 
 353:Core/Src/ad9518.c **** int ad9518_bus_selftest(ad9518_dev_t *d)
 354:Core/Src/ad9518.c **** {
 355:Core/Src/ad9518.c ****     /* PLL2 (0x017) is a benign scratch location: it holds no critical
 356:Core/Src/ad9518.c ****      * setting in this configuration and is fully readable/writable. */
 357:Core/Src/ad9518.c ****     static const uint8_t patterns[] = {0x00, 0xA5, 0x5A, 0xFF, 0x00};
 358:Core/Src/ad9518.c ****     int fails = 0;
 359:Core/Src/ad9518.c **** 
 360:Core/Src/ad9518.c ****     D(d, "[selftest] write/readback patterns to 0x017\r\n");
 361:Core/Src/ad9518.c ****     for (unsigned i = 0; i < sizeof(patterns); i++)
 362:Core/Src/ad9518.c ****     {
 363:Core/Src/ad9518.c ****         uint8_t got = 0;
 364:Core/Src/ad9518.c ****         ad9518_write(d, AD9518_PLL2, patterns[i]);
 365:Core/Src/ad9518.c ****         ad9518_transfer(d);
 366:Core/Src/ad9518.c ****         ad9518_read(d, AD9518_PLL2, &got);
 367:Core/Src/ad9518.c ****         Df(d, "  wrote 0x%02X read 0x%02X %s\r\n",
 368:Core/Src/ad9518.c ****            patterns[i], got, (got == patterns[i]) ? "ok" : "FAIL");
 369:Core/Src/ad9518.c ****         if (got != patterns[i])
 370:Core/Src/ad9518.c ****             fails++;
 371:Core/Src/ad9518.c ****     }
 372:Core/Src/ad9518.c ****     ad9518_write(d, AD9518_PLL2, 0x00);
 373:Core/Src/ad9518.c ****     ad9518_transfer(d);
 374:Core/Src/ad9518.c **** 
 375:Core/Src/ad9518.c ****     if (fails)
 376:Core/Src/ad9518.c ****         Df(d, "[selftest] %d/%u patterns failed\r\n", fails, (unsigned)sizeof(patterns));
 377:Core/Src/ad9518.c ****     else
 378:Core/Src/ad9518.c ****         D(d, "[selftest] bus round-trips correctly\r\n");
 379:Core/Src/ad9518.c ****     return fails ? -1 : 0;
 380:Core/Src/ad9518.c **** }
 381:Core/Src/ad9518.c **** 
 382:Core/Src/ad9518.c **** /* ------------------------------------------------------------------ */
 383:Core/Src/ad9518.c **** /* divider planning                                                    */
 384:Core/Src/ad9518.c **** /* ------------------------------------------------------------------ */
 385:Core/Src/ad9518.c **** 
 386:Core/Src/ad9518.c **** /* PLL1[2:0] selects the prescaler. Table from the Linux driver; the high
ARM GAS  /var/folders/0g/t37nqzqx51l7sfxbqc44l9hw0000gn/T//ccBBrdod.s 			page 18


 387:Core/Src/ad9518.c ****  * bit marks fixed-divide modes, where the A counter is unused. */
 388:Core/Src/ad9518.c **** #define IS_FD 0x80
 389:Core/Src/ad9518.c **** static const uint8_t to_prescaler[8] = {
 390:Core/Src/ad9518.c ****     1 | IS_FD,
 391:Core/Src/ad9518.c ****     2 | IS_FD,
 392:Core/Src/ad9518.c ****     2,
 393:Core/Src/ad9518.c ****     4,
 394:Core/Src/ad9518.c ****     8,
 395:Core/Src/ad9518.c ****     16,
 396:Core/Src/ad9518.c ****     32,
 397:Core/Src/ad9518.c ****     3 | IS_FD,
 398:Core/Src/ad9518.c **** };
 399:Core/Src/ad9518.c **** 
 400:Core/Src/ad9518.c **** /* The B counter cannot be clocked at the full VCO rate; the prescaler must
 401:Core/Src/ad9518.c ****  * bring it down. Keep the prescaler output conservatively low. */
 402:Core/Src/ad9518.c **** #define BCNT_IN_MAX_HZ 250000000u
 403:Core/Src/ad9518.c **** 
 404:Core/Src/ad9518.c **** int ad9518_plan(uint32_t ref_hz, uint32_t target_hz,
 405:Core/Src/ad9518.c ****                 uint32_t vco_min_hz, uint32_t vco_max_hz,
 406:Core/Src/ad9518.c ****                 ad9518_plan_t *plan)
 407:Core/Src/ad9518.c **** {
 408:Core/Src/ad9518.c ****     long best_err = -1;
 409:Core/Src/ad9518.c ****     uint32_t best_centre = 0;
 410:Core/Src/ad9518.c ****     uint32_t vco_mid = (uint32_t)(((uint64_t)vco_min_hz + vco_max_hz) / 2);
 411:Core/Src/ad9518.c **** 
 412:Core/Src/ad9518.c ****     if (!ref_hz || !target_hz || !plan)
 413:Core/Src/ad9518.c ****         return -1;
 414:Core/Src/ad9518.c **** 
 415:Core/Src/ad9518.c ****     for (uint8_t pi = 0; pi < 8; pi++)
 416:Core/Src/ad9518.c ****     {
 417:Core/Src/ad9518.c ****         uint8_t praw = to_prescaler[pi];
 418:Core/Src/ad9518.c ****         int fixed_div = (praw & IS_FD) != 0;
 419:Core/Src/ad9518.c ****         uint8_t P = praw & (uint8_t)~IS_FD;
 420:Core/Src/ad9518.c **** 
 421:Core/Src/ad9518.c ****         for (uint16_t B = 3; B <= 1000; B++)
 422:Core/Src/ad9518.c ****         {
 423:Core/Src/ad9518.c ****             uint8_t amax = fixed_div ? 0 : (uint8_t)(P - 1);
 424:Core/Src/ad9518.c **** 
 425:Core/Src/ad9518.c ****             for (uint8_t A = 0; A <= amax; A++)
 426:Core/Src/ad9518.c ****             {
 427:Core/Src/ad9518.c ****                 /* In dual-modulus mode the A counter must be less than B. */
 428:Core/Src/ad9518.c ****                 if (!fixed_div && A >= B)
 429:Core/Src/ad9518.c ****                     continue;
 430:Core/Src/ad9518.c **** 
 431:Core/Src/ad9518.c ****                 uint32_t N = (uint32_t)P * B + A;
 432:Core/Src/ad9518.c ****                 uint64_t vco = (uint64_t)ref_hz * N; /* R = 1 */
 433:Core/Src/ad9518.c **** 
 434:Core/Src/ad9518.c ****                 if (vco < vco_min_hz || vco > vco_max_hz)
 435:Core/Src/ad9518.c ****                     continue;
 436:Core/Src/ad9518.c ****                 if (vco / P > BCNT_IN_MAX_HZ)
 437:Core/Src/ad9518.c ****                     continue;
 438:Core/Src/ad9518.c **** 
 439:Core/Src/ad9518.c ****                 /* Distance from the middle of the tuning range. Among plans
 440:Core/Src/ad9518.c ****                  * that hit the target exactly, prefer the one whose VCO sits
 441:Core/Src/ad9518.c ****                  * furthest from the band edges - a VCO parked at the very
 442:Core/Src/ad9518.c ****                  * bottom or top of its range may fail to lock over
 443:Core/Src/ad9518.c ****                  * temperature and process variation even though it locks on
ARM GAS  /var/folders/0g/t37nqzqx51l7sfxbqc44l9hw0000gn/T//ccBBrdod.s 			page 19


 444:Core/Src/ad9518.c ****                  * the bench at room temperature. */
 445:Core/Src/ad9518.c ****                 uint32_t centre = (vco > vco_mid)
 446:Core/Src/ad9518.c ****                                       ? (uint32_t)(vco - vco_mid)
 447:Core/Src/ad9518.c ****                                       : (uint32_t)(vco_mid - vco);
 448:Core/Src/ad9518.c **** 
 449:Core/Src/ad9518.c ****                 for (uint8_t vd = 2; vd <= 6; vd++)
 450:Core/Src/ad9518.c ****                 {
 451:Core/Src/ad9518.c ****                     uint64_t bus = vco / vd;
 452:Core/Src/ad9518.c ****                     for (uint8_t cd = 1; cd <= 32; cd++)
 453:Core/Src/ad9518.c ****                     {
 454:Core/Src/ad9518.c ****                         uint64_t out = bus / cd;
 455:Core/Src/ad9518.c ****                         long err = (long)out - (long)target_hz;
 456:Core/Src/ad9518.c ****                         if (err < 0)
 457:Core/Src/ad9518.c ****                             err = -err;
 458:Core/Src/ad9518.c **** 
 459:Core/Src/ad9518.c ****                         int better = 0;
 460:Core/Src/ad9518.c ****                         if (best_err < 0)
 461:Core/Src/ad9518.c ****                             better = 1;
 462:Core/Src/ad9518.c ****                         else if (err < best_err)
 463:Core/Src/ad9518.c ****                             better = 1;
 464:Core/Src/ad9518.c ****                         else if (err == best_err &&
 465:Core/Src/ad9518.c ****                                  centre < best_centre)
 466:Core/Src/ad9518.c ****                             better = 1;
 467:Core/Src/ad9518.c **** 
 468:Core/Src/ad9518.c ****                         if (better)
 469:Core/Src/ad9518.c ****                         {
 470:Core/Src/ad9518.c ****                             best_err = err;
 471:Core/Src/ad9518.c ****                             best_centre = centre;
 472:Core/Src/ad9518.c ****                             plan->r_counter = 1;
 473:Core/Src/ad9518.c ****                             plan->a_counter = A;
 474:Core/Src/ad9518.c ****                             plan->b_counter = B;
 475:Core/Src/ad9518.c ****                             plan->prescaler_idx = pi;
 476:Core/Src/ad9518.c ****                             plan->prescaler = P;
 477:Core/Src/ad9518.c ****                             plan->vco_divider = vd;
 478:Core/Src/ad9518.c ****                             plan->chan_divider = cd;
 479:Core/Src/ad9518.c ****                             plan->vco_hz = (uint32_t)vco;
 480:Core/Src/ad9518.c ****                             plan->out_hz = (uint32_t)out;
 481:Core/Src/ad9518.c ****                         }
 482:Core/Src/ad9518.c ****                     }
 483:Core/Src/ad9518.c ****                 }
 484:Core/Src/ad9518.c ****             }
 485:Core/Src/ad9518.c ****         }
 486:Core/Src/ad9518.c ****     }
 487:Core/Src/ad9518.c **** 
 488:Core/Src/ad9518.c ****     if (best_err < 0)
 489:Core/Src/ad9518.c ****         return -1;
 490:Core/Src/ad9518.c ****     return (best_err == 0) ? 0 : 1;
 491:Core/Src/ad9518.c **** }
 492:Core/Src/ad9518.c **** 
 493:Core/Src/ad9518.c **** /* Channel divider encoding: ratio 2..32 becomes a hi/lo nibble pair.
 494:Core/Src/ad9518.c ****  * Same arithmetic as ad9517_calc_divider_hi_lo() in the Linux driver. */
 495:Core/Src/ad9518.c **** static uint8_t div_hi_lo(uint8_t ratio)
 496:Core/Src/ad9518.c **** {
