   1:Core/Src/ad9518.c **** #include "ad9518.h"
   2:Core/Src/ad9518.c **** 
   3:Core/Src/ad9518.c **** /* ---- low level ---------------------------------------------------------- */
   4:Core/Src/ad9518.c **** 
   5:Core/Src/ad9518.c **** int ad9518_reg_write(ad9518_dev_t *d, uint16_t reg, uint8_t val)
   6:Core/Src/ad9518.c **** {
   7:Core/Src/ad9518.c ****     uint16_t cmd = AD9518_WRITE | AD9518_CNT(1) | AD9518_ADDR(reg);
   8:Core/Src/ad9518.c ****     uint8_t buf[3] = {(uint8_t)(cmd >> 8), (uint8_t)(cmd & 0xFF), val};
   9:Core/Src/ad9518.c ****     return d->spi_write(buf, 3);
  10:Core/Src/ad9518.c **** }
  11:Core/Src/ad9518.c **** 
  12:Core/Src/ad9518.c **** int ad9518_reg_read(ad9518_dev_t *d, uint16_t reg, uint8_t *val)
  13:Core/Src/ad9518.c **** {
  14:Core/Src/ad9518.c ****     uint16_t cmd = AD9518_READ | AD9518_CNT(1) | AD9518_ADDR(reg);
  15:Core/Src/ad9518.c ****     uint8_t tx[2] = {(uint8_t)(cmd >> 8), (uint8_t)(cmd & 0xFF)};
  16:Core/Src/ad9518.c ****     return d->spi_read(tx, 2, val, 1);
  17:Core/Src/ad9518.c **** }
  18:Core/Src/ad9518.c **** 
  19:Core/Src/ad9518.c **** int ad9518_update(ad9518_dev_t *d)
  20:Core/Src/ad9518.c **** {
  21:Core/Src/ad9518.c ****     return ad9518_reg_write(d, AD9518_TRANSFER, AD9518_TRANSFER_NOW);
  22:Core/Src/ad9518.c **** }
  23:Core/Src/ad9518.c **** 
  24:Core/Src/ad9518.c **** int ad9518_read_part_id(ad9518_dev_t *d, uint8_t *id)
  25:Core/Src/ad9518.c **** {
  26:Core/Src/ad9518.c ****     return ad9518_reg_read(d, AD9518_PARTID, id);
  27:Core/Src/ad9518.c **** }
  28:Core/Src/ad9518.c **** 
  29:Core/Src/ad9518.c **** /* ---- helpers ------------------------------------------------------------ */
  30:Core/Src/ad9518.c **** 
  31:Core/Src/ad9518.c **** /* divider = (LO+1)+(HI+1) = LO+HI+2, split as evenly as possible.
  32:Core/Src/ad9518.c ****  * Reg byte = (HI<<4)|LO. Divider 1 uses the bypass bit instead. */
